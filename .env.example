# ==========================================
# TEMPLESTORE ENVIRONMENT CONFIGURATION
# Phase 1 Prototype — Ready for Production Upgrade
# ==========================================

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth / Auth.js / Clerk)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
# GITHUB_ID=your_github_client_id
# GITHUB_SECRET=your_github_client_secret

# Stripe Payments (For production checkout)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Web3 / Crypto QR Payments (Optional)
# NEXT_PUBLIC_PAYMENT_WALLET_ADDRESS=0x9482aF1e96740B7e9Bf7F139C24A409A675f921D

# Database (PostgreSQL / Prisma / Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/templestore?schema=public

# Cloud Storage (AWS S3 / Cloudflare R2 for ZIP downloads)
# STORAGE_BUCKET_NAME=templestore-assets
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
